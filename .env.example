# Copy this file to .env and fill in real values before going to production.

PORT=3000

# Admin panel password (Basic Auth). CHANGE THIS before deploying anywhere public.
ADMIN_PASSWORD=changeme

# Base URL used when printing/emailing links to users (no trailing slash).
BASE_URL=http://localhost:3000

# --- Metrics provider ---
# If METRICS_PROVIDER=mock (default), the app fabricates deterministic
# DR / spam-score / traffic numbers per domain so you can test the whole
# flow with zero external accounts. Every mock-derived number is clearly
# labeled "מדומה" (simulated) in the admin UI so it can never be mistaken
# for a real score.
#
# Set METRICS_PROVIDER=moz and fill in the two keys below to use real
# Moz Links API data instead (https://moz.com/products/api). Any other
# API (Ahrefs, Semrush, Majestic) can be wired in by implementing the
# same interface in src/metrics.js.
METRICS_PROVIDER=mock
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=

# --- Quality gate thresholds (0-100 scales, see README) ---
MIN_DR=10
MAX_SPAM_SCORE=30
MIN_TRAFFIC=50

# Borderline band around the thresholds that gets queued for manual
# admin review instead of being auto-approved/auto-rejected.
REVIEW_BAND_SPAM=10
REVIEW_BAND_DR=5

# Matching: how far apart (relative) two sites' DR may be and still count
# as a compatible match, e.g. 0.3 = within +/-30%.
DR_MATCH_TOLERANCE=0.3
