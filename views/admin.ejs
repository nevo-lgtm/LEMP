<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ניהול — החלפת קישורים</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap wrap-wide">
    <h1>לוח ניהול</h1>

    <% if (flash) { %>
      <div class="alert alert-info"><%= flash %></div>
    <% } %>

    <section class="card">
      <h2>סטטיסטיקת משפך</h2>
      <div class="stat-grid">
        <div class="stat"><div class="stat-num"><%= stats.totalSites %></div><div class="stat-label">אתרים שנרשמו</div></div>
        <div class="stat"><div class="stat-num"><%= stats.processing %></div><div class="stat-label">בעיבוד / ממתינים לאישור</div></div>
        <div class="stat"><div class="stat-num"><%= stats.approved %></div><div class="stat-label">פעילים</div></div>
        <div class="stat"><div class="stat-num"><%= stats.pendingReview %></div><div class="stat-label">ממתינים לבדיקה ידנית</div></div>
        <div class="stat"><div class="stat-num"><%= stats.rejected %></div><div class="stat-label">נדחו</div></div>
        <div class="stat"><div class="stat-num"><%= stats.matchesProposed %></div><div class="stat-label">התאמות שהוצעו</div></div>
        <div class="stat"><div class="stat-num"><%= stats.matchesRevealed %></div><div class="stat-label">אושרו הדדית</div></div>
        <div class="stat stat-highlight"><div class="stat-num"><%= stats.matchesCompleted %></div><div class="stat-label">קישורים חיים ומאומתים</div></div>
        <div class="stat"><div class="stat-num"><%= stats.matchesBroken %></div><div class="stat-label">קישורים שהוסרו</div></div>
        <div class="stat"><div class="stat-num"><%= stats.matchesDeclined %></div><div class="stat-label">נדחו/בוטלו</div></div>
      </div>
      <p class="fine-print">
        המדד שקובע אם יש כאן מוצר הוא "קישורים חיים ומאומתים", לא הרשמות.
      </p>
    </section>

    <section class="card">
      <h2>עבודות רקע (drip + אימות)</h2>
      <p class="muted">
        ספק מדדים: <strong><%= metricsProvider %></strong> ·
        ספק מייל: <strong><%= emailProvider %></strong> ·
        סבילות DR להתאמה: ±<%= Math.round(tolerance * 100) %>% ·
        סף ספאם: <%= thresholds.maxSpamScore %> · סף DR מינימלי: <%= thresholds.minDr %>
      </p>
      <p class="muted">
        הרצת Drip אחרונה: <%= schedulerState.lastDripRunAt ? new Date(schedulerState.lastDripRunAt).toLocaleString('he-IL') : 'טרם רצה' %> ·
        סבב אימות אחרון: <%= schedulerState.lastVerificationRunAt ? new Date(schedulerState.lastVerificationRunAt).toLocaleString('he-IL') : 'טרם רץ' %>
      </p>
      <p class="fine-print">
        בהרצה רגילה שני הסבבים רצים אוטומטית פעם ביום ברקע. הכפתורים כאן
        מיועדים לבדיקה/הרצה ידנית מיידית.
      </p>
      <div class="actions">
        <form method="post" action="/admin/run-drip" class="inline">
          <button type="submit" class="btn btn-primary">הרץ סבב התאמות + שלח התראות עכשיו</button>
        </form>
        <form method="post" action="/admin/run-verification" class="inline">
          <button type="submit" class="btn btn-secondary">הרץ בדיקת no-show + אימות קישורים עכשיו</button>
        </form>
      </div>
    </section>

    <section class="card">
      <h2>תור בדיקה ידנית (<%= reviewQueue.length %>)</h2>
      <% if (reviewQueue.length === 0) { %>
        <p class="muted">אין אתרים הממתינים לבדיקה כרגע.</p>
      <% } %>
      <% reviewQueue.forEach(function(s) { %>
        <div class="review-row">
          <div>
            <strong><%= s.domain %></strong> · <%= s.niche %> · <%= s.email %><br>
            DR <%= s.dr %> · ספאם <%= s.spamScore %> · תעבורה <%= s.trafficEstimate %>
            <% if (s.metricsSource === 'mock') { %><span class="badge">מדומה</span><% } %>
            <div class="fine-print">סיבות: <%= (s.gateReasons || []).join('; ') %></div>
          </div>
          <div class="actions">
            <form method="post" action="/admin/sites/<%= s.id %>/approve" class="inline">
              <button type="submit" class="btn btn-primary">אשר</button>
            </form>
            <form method="post" action="/admin/sites/<%= s.id %>/reject" class="inline">
              <button type="submit" class="btn btn-secondary">דחה</button>
            </form>
          </div>
        </div>
      <% }) %>
    </section>

    <section class="card">
      <h2>אמינות אתרים (<%= reliabilityRows.length %>)</h2>
      <p class="fine-print">
        המנגנון האנטי-שימוש-לא-הוגן: לכל אתר נספר כמה פעמים הוצעה לו התאמה,
        כמה מהן אומתו בפועל (הקישור אכן עלה), כמה פעמים הוא "לא הופיע"
        (לא דיווח קישור בזמן וההתאמה בוטלה אוטומטית), וכמה פעמים הוא הוריד
        קישור אחרי שהצד השני כבר קיבל את שלו.
      </p>
      <table class="admin-table">
        <thead>
          <tr><th>דומיין</th><th>נישה</th><th>הוצעו</th><th>אומתו</th><th>no-show</th><th>הוריד אחרי הדדיות</th></tr>
        </thead>
        <tbody>
          <% reliabilityRows.forEach(function(r) { %>
            <tr>
              <td><%= r.domain %></td>
              <td><%= r.niche %></td>
              <td><%= r.offered %></td>
              <td><%= r.verified %></td>
              <td><%= r.noShow %></td>
              <td><%= r.removedAfterReciprocation %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="card">
      <h2>כל האתרים (<%= sites.length %>)</h2>
      <table class="admin-table">
        <thead>
          <tr><th>דומיין</th><th>נישה</th><th>DR</th><th>ספאם</th><th>תעבורה</th><th>סטטוס</th><th>נרשם</th></tr>
        </thead>
        <tbody>
          <% sites.forEach(function(s) { %>
            <tr>
              <td><%= s.domain %></td>
              <td><%= s.niche %></td>
              <td><%= s.dr %></td>
              <td><%= s.spamScore %></td>
              <td><%= s.trafficEstimate %></td>
              <td><span class="pill pill-<%= s.status %>"><%= s.status %></span></td>
              <td><%= new Date(s.createdAt).toLocaleDateString('he-IL') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="card">
      <h2>כל ההתאמות (<%= matchRows.length %>)</h2>
      <table class="admin-table">
        <thead>
          <tr><th>אתר א'</th><th>אתר ב'</th><th>נישה</th><th>סטטוס</th><th>נוצר</th></tr>
        </thead>
        <tbody>
          <% matchRows.forEach(function(m) { %>
            <tr>
              <td><%= m.siteA ? m.siteA.domain : '-' %></td>
              <td><%= m.siteB ? m.siteB.domain : '-' %></td>
              <td><%= m.niche %></td>
              <td><span class="pill pill-<%= m.status %>"><%= m.statusLabel %></span></td>
              <td><%= new Date(m.createdAt).toLocaleDateString('he-IL') %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

    <section class="card">
      <h2>יומן מיילים מדומים (<%= notifications.length %>)</h2>
      <p class="fine-print">
        ספק המייל כרגע הוא <strong><%= emailProvider %></strong> — כל עוד הוא
        <code>mock</code>, שום מייל לא באמת יוצא; הרשומות כאן הן מה שהיה נשלח.
      </p>
      <% if (notifications.length === 0) { %>
        <p class="muted">עדיין לא נשלחו התראות.</p>
      <% } %>
      <% notifications.forEach(function(n) { %>
        <div class="review-row">
          <div>
            <strong><%= n.to %></strong> — <%= n.subject %>
            <div class="fine-print"><%= new Date(n.sentAt).toLocaleString('he-IL') %></div>
          </div>
        </div>
      <% }) %>
    </section>
  </div>
</body>
</html>
